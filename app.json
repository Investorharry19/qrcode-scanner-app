{
  "expo": {
    "name": "qrcode-scanner",
    "slug": "qrcode-scanner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/ss.png",
    "scheme": "qrcodescanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to scan QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.hendrix_ameh.qrcodescanner"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ss.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow qrcode-scanner to save QR codes to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDB623",
          "image": "./assets/images/ss.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56617a76-8627-45e5-878c-b025671e0a52"
      }
    }
  }
}
